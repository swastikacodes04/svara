# GEMINI_API_KEY: Required for optional server-side Gemini explainability narrative generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAGA_MODEL_API_URL: Optional external Python (FastAPI) ML Raga classifier inference endpoint.
# Example: http://localhost:8000/predict
RAGA_MODEL_API_URL=""

# RAGA_MODEL_API_KEY: Optional bearer token for authenticating with the external ML classifier service.
RAGA_MODEL_API_KEY=""

# MAX_UPLOAD_MB: Maximum accepted audio upload file size in megabytes (default: 25).
MAX_UPLOAD_MB="25"
